meta {
  name: 4. Bericht ophalen (detail)
  type: http
  seq: 4
}

get {
  url: {{baseUrlUitvraag}}/berichten/{{berichtId}}
  auth: none
}

headers {
  X-Ontvanger: {{ontvangerHeaderPersoon}}
  traceparent: 00-{{traceId}}-{{parentSpanId}}-01
}

docs {
  Bericht-detail uit de sessiecache. Draagt dezelfde `afzenderNaam` als het lijstantwoord
  (request 2): de weergavenaam uit het magazijnregister bij `magazijnId`, of afwezig wanneer
  het register geen naam voor die organisatie kent.
}
