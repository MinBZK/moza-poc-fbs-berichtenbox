meta {
  name: 4. Bericht ophalen (detail)
  type: http
  seq: 4
}

get {
  url: {{baseUrlUitvraag}}/berichten/{{berichtId}}
  auth: none
}

headers {
  X-Ontvanger: {{ontvangerHeaderPersoon}}
  traceparent: 00-{{traceId}}-{{parentSpanId}}-01
}

docs {
  Draagt dezelfde `afzenderNaam` als het lijstantwoord: de weergavenaam uit het
  magazijnregister, of afwezig wanneer het register er geen kent.
}
