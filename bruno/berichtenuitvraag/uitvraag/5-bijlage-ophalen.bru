meta {
  name: 5. Bijlage ophalen
  type: http
  seq: 5
}

get {
  url: {{baseUrlUitvraag}}/berichten/{{berichtId}}/bijlagen/{{bijlageId}}?magazijnId={{magazijnId}}
  auth: none
}

params:query {
  magazijnId: {{magazijnId}}
}

headers {
  X-Ontvanger: {{ontvangerHeaderPersoon}}
  X-Sessie: {{sessie}}
  traceparent: 00-{{traceId}}-{{parentSpanId}}-01
}
