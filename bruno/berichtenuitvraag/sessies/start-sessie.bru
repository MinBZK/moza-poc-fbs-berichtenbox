meta {
  name: 1. Sessie starten
  type: http
  seq: 1
}

post {
  url: {{baseUrlUitvraag}}/sessies
  body: none
  auth: none
}

headers {
  X-Ontvanger: {{ontvangerHeaderPersoon}}
  traceparent: 00-{{traceId}}-{{parentSpanId}}-01
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("sessie", res.body.sessieId);
  }
}

docs {
  Geeft 201 met `sessieId`; de waarde komt automatisch in de omgevingsvariabele `sessie` en gaat
  als `X-Sessie` mee op de requests onder `/berichten`. Te veel gelijktijdige sessies geeft 429.
}
