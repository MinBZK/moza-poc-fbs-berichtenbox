meta {
  name: 6. Bericht uit zijn map halen (PATCH map "")
  type: http
  seq: 6
}

patch {
  url: {{baseUrlMagazijn}}/berichten/{{berichtId}}
  body: json
  auth: none
}

headers {
  X-Ontvanger: {{ontvangerHeaderPersoon}}
  Content-Type: application/merge-patch+json
  traceparent: 00-{{traceId}}-{{parentSpanId}}-01
}

body:json {
  {
    "map": ""
  }
}
