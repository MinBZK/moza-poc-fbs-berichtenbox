<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alleen voor CI. GitHub-runners delen hun uitgaande adressen, en Maven Central beantwoordt een
  piek vanaf die adressen met HTTP 429. Google's mirror van Central staat daarom vóór Central:
  Maven vraagt elk artefact eerst daar op en valt terug op Central (hieronder) als de mirror
  het niet heeft of niet bereikbaar is. Geen <mirrorOf>: die vervangt Central, en dan breekt
  een artefact dat de mirror nog niet heeft de build.

  checksumPolicy fail: een artefact dat niet bij zijn checksum past, wordt geweigerd en bij de
  volgende repository opnieuw opgehaald. Onder de standaard `warn` belandt het in de cache van main,
  en elke PR erft het tot de volgende pom-wijziging. Central staat hier daarom ook, met dezelfde id
  als in de super-POM, zodat de terugval die policy ook krijgt. Tegen een bron die artefact én
  checksum vervalst helpt dit niet; die vergelijkt alleen met zichzelf.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>central-mirror</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central-eu.storage-download.googleapis.com/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central-eu.storage-download.googleapis.com/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-mirror</activeProfile>
  </activeProfiles>
</settings>
