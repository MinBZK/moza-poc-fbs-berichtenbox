<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alleen voor CI. GitHub-runners delen hun uitgaande adressen, en Maven Central beantwoordt een
  piek vanaf die adressen met HTTP 429. Google's spiegel van Central staat daarom vóór Central:
  Maven vraagt elk artefact eerst daar op en valt terug op Central (de super-POM) als de spiegel
  het niet heeft of niet bereikbaar is. Geen <mirrorOf>: die vervangt Central, en dan breekt
  een artefact dat de spiegel nog niet heeft de build.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>central-spiegel</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central-eu.storage-download.googleapis.com/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central-eu.storage-download.googleapis.com/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-spiegel</activeProfile>
  </activeProfiles>
</settings>
