{
  "priority": 100,
  "request": {
    "method": "POST",
    "url": "/api/profielservice/v1/partij",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.identificatieType =~ /^(BSN|KVK|RSIN)$/)]"
      },
      {
        "matchesJsonPath": "$[?(@.identificatieNummer =~ /^[0-9]+$/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "partijId": 1,
      "identificaties": [],
      "voorkeuren": [
        {
          "id": 1,
          "voorkeurType": "OntvangViaBerichtenbox",
          "waarde": "true",
          "scopes": [
            {
              "partij": {
                "identificatieType": "OIN",
                "identificatieNummer": "00000000000000100000"
              }
            }
          ]
        }
      ],
      "contactgegevens": []
    }
  }
}
