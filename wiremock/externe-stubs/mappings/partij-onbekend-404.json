{
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/api/profielservice/v1/partij",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.identificatieType == 'BSN')]"
      },
      {
        "matchesJsonPath": "$[?(@.identificatieNummer == '999996915')]"
      }
    ]
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "jsonBody": {
      "type": "about:blank",
      "title": "Partij niet gevonden",
      "status": 404,
      "detail": "Geen partij gevonden voor het opgegeven identificatienummer."
    }
  }
}
