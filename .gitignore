# IDE
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Build
target/
build/
dist/
*.class
*.jar
*.war

# Environment
.env
.env.local
.env.zadctl
*.local

# Logs
*.log

# Structurizr Lite (gegenereerd)
docs/architecture/.structurizr/
docs/architecture/workspace.json

# Dependencies
node_modules/
/docs/architecture/workspace.json
/docs/architecture/.structurizr/

# Claude Code (lokaal)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/ralph-loop.local.md

# Coredumps (root only — ignoreert geen toekomstige core/ source-map)
/core

# Tijdelijke files van import-rewrite-scripts
*.kt.tmp

# Gegenereerde demo-artefacten (fase 6 — veel magazijnen). Regenereren met demo/genereer-magazijnen.py.
demo/generated/

# FSC-peer certificaten (privésleutels — NOOIT committen)
demo/environment/*/pki/ca/
demo/environment/*/pki/out/
demo/environment/*/pki/internal/
demo/environment/*/pki/zad-upload/

# Lokale contract-bootstrap-state (content_hash, niet geheim maar host-lokaal)
demo/environment/*/contracts/.bootstrap-state/

# Bytecode-cache van de Python-hulpscripts; een artefact van het draaien, geen bron.
__pycache__/
*.pyc

# Staging voor de build-context van het demo-profiel-image: demo/genereer-magazijnen.py schrijft in
# demo/generated/, en dat ligt buiten de context `wiremock/`. De CI-stap kopieert de vier
# ondernemer-stubs hierheen; .gitkeep houdt de map bestaanbaar zodat de COPY ook zonder gedraaid
# script slaagt.
wiremock/demo-profiel/generated/*.json
