# Eén origin voor de hele demo: de berichtenbox van de proeftuin, het bedieningspaneel en de
# keten-API's. Dat is geen sierlijkheid maar noodzaak — zonder gedeelde origin komt de personalijst
# niet aan (die valt binnen de proeftuin-container onder zijn eigen `location /api/` en zou bij de
# uitvraag uitkomen), en kan het paneel de berichtenbox niet laten verversen.
#
# Online geldt dit niet: daar proxyt de proeftuin zelf naar de uitvraag. Deze proxy is dus
# demo-lijm, geen onderdeel van het stelsel.
#
# De bestemmingen komen uit env-vars omdat de podman-hostnet-modus geen container-DNS heeft: daar
# is alles 127.0.0.1 met een eigen poort. nginx vult ze bij het starten in vanuit
# /etc/nginx/templates/.
# De Host-header wordt niet doorgezet: geen van deze diensten doet aan virtual hosting, en zo
# hangt de demo niet af van hoe streng een dienst de Host-header toetst. Quarkus weigert onder
# profiel dev een Host die niet naar localhost wijst; de demo-console zet die eis daarom uit,
# maar deze proxy hoeft daar niet op te leunen.
server {
    listen ${PROXY_BIND}:${PROXY_PORT};

    # Niets bewaren. De onderdelen van de demo worden tijdens het werken eraan vervangen — een
    # nieuwe build van de proeftuin, een herstart van de console — en zonder deze regel toont de
    # browser heuristisch de vorige versie. Dan zoek je een fout die er niet meer is.
    add_header Cache-Control "no-store" always;

    # Alles wat de proeftuin zelf serveert, inclusief /moza/berichtenbox/.
    location / {
        proxy_pass ${PROEFTUIN_UPSTREAM};
    }

    # Het bedieningspaneel van de demo-console, dat de berichtenbox in een frame toont.
    location /bediening/ {
        proxy_pass ${CONSOLE_UPSTREAM}/;
    }

    # De personalijst komt uit een eigen dienst, zodat een berichtenbox hem kan lezen zonder bij
    # het bedieningspaneel te kunnen. Op een gedeelde omgeving is dat het verschil tussen een
    # leeslijst en een knop die twee databases leegt; lokaal houden we dezelfde scheiding aan, want
    # anders bewijst de demo iets dat online niet klopt. nginx kiest het langste passende prefix,
    # dus de volgorde hieronder is vrij; het specifieke pad staat vóór de catch-all omdat het zo
    # leest.
    location = /api/demo/personas {
        proxy_pass ${PERSONAS_UPSTREAM};
    }

    # Demo-gereedschap: storingen, vullen, legen.
    location /api/demo/ {
        proxy_pass ${CONSOLE_UPSTREAM};
    }

    # De keten. De ophaalronde is een SSE-stream: zonder deze vier regels komt de voortgang per
    # organisatie pas aan het eind binnen en lijkt de pagina te hangen tot het traagste magazijn
    # klaar is. De lange read-timeout dekt een ronde langs tientallen magazijnen.
    location /api/v1/ {
        proxy_pass ${UITVRAAG_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
