# Eén origin voor de hele demo: het portaal met zijn Berichtenbox, het bedieningspaneel en de
# personalijst. Het paneel toont de Berichtenbox in een frame en kan hem alleen op dezelfde origin
# gericht laten verversen; op een andere origin weigert de browser die toegang.
#
# Naar de uitvraag gaat hier geen route: het portaal praat server-side met de keten, via zijn eigen
# /api/keten. Deze proxy is dus demo-lijm, geen onderdeel van het stelsel.
#
# De bestemmingen komen uit env-vars omdat de podman-hostnet-modus geen container-DNS heeft: daar
# is alles 127.0.0.1 met een eigen poort. nginx vult ze bij het starten in vanuit
# /etc/nginx/templates/.
# De Host-header wordt niet doorgezet: geen van deze diensten doet aan virtual hosting, en zo
# hangt de demo niet af van hoe streng een dienst de Host-header toetst. Quarkus weigert onder
# profiel dev een Host die niet naar localhost wijst; de demo-console zet die eis daarom uit,
# maar deze proxy hoeft daar niet op te leunen.
#
# Het portaal krijgt wel `X-Forwarded-Host`. Next.js vergelijkt bij een Server Action de `Origin`
# van de browser met die host, en weigert de action met een 500 als ze verschillen; zonder deze
# header vergelijkt hij met de upstream-host. Elke location die het portaal bedient, zet hem zelf:
# een `proxy_set_header` in een location heft de erfenis van het serverblok op.
server {
    listen ${PROXY_BIND}:${PROXY_PORT};

    # Niets bewaren. De onderdelen van de demo worden tijdens het werken eraan vervangen — een
    # nieuwe versie van het portaal, een herstart van de console — en zonder deze regel toont de
    # browser heuristisch de vorige versie. Dan zoek je een fout die er niet meer is.
    add_header Cache-Control "no-store" always;

    # Alles wat het portaal zelf serveert, inclusief /berichtenbox.
    location / {
        proxy_pass ${PORTAAL_UPSTREAM};
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # De keten via het portaal. Ophalen en volgen zijn SSE-streams: zonder deze vier regels komt de
    # voortgang per organisatie pas aan het eind binnen en lijkt de pagina te hangen tot het
    # traagste magazijn klaar is. De lange read-timeout dekt een ronde langs tientallen magazijnen
    # en een open Berichtenbox die nieuwe berichten volgt.
    location /api/keten/ {
        proxy_pass ${PORTAAL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Het bedieningspaneel van de demo-console, dat de Berichtenbox in een frame toont.
    location /bediening/ {
        proxy_pass ${CONSOLE_UPSTREAM}/;
    }

    # De personalijst komt uit een eigen dienst, zodat een berichtenbox hem kan lezen zonder bij
    # het bedieningspaneel te kunnen. Op een gedeelde omgeving is dat het verschil tussen een
    # leeslijst en een knop die twee databases leegt; lokaal houden we dezelfde scheiding aan, want
    # anders bewijst de demo iets dat online niet klopt. nginx kiest het langste passende prefix,
    # dus de volgorde hieronder is vrij; het specifieke pad staat vóór de catch-all omdat het zo
    # leest.
    location = /api/demo/personas {
        proxy_pass ${PERSONAS_UPSTREAM};
    }

    # Demo-gereedschap: storingen, vullen, legen.
    location /api/demo/ {
        proxy_pass ${CONSOLE_UPSTREAM};
    }
}
